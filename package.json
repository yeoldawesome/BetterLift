{
  "name": "better-lift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/icons.ps1",
    "test:api": "node scripts/smoke.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=esm --outfile=node_modules/.e2e.mjs --define:import.meta.env.VITE_API_URL=\\\"http://127.0.0.1:8090\\\" --log-level=warning && node node_modules/.e2e.mjs",
    "test:iphone": "playwright test -c tests/iphone/playwright.config.ts"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "pocketbase": "^0.29.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
