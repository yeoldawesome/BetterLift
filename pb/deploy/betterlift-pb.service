[Unit]
Description=Better Lift API (PocketBase)
After=network.target

[Service]
Type=simple
User=betterlift
Group=betterlift
WorkingDirectory=/opt/betterlift
# Push notification settings (optional, see pb/push). The leading "-" means it's fine if the file is missing.
EnvironmentFile=-/etc/betterlift/push.env
ExecStart=/opt/betterlift/pocketbase serve --http=127.0.0.1:8090 --origins=https://app.example.com
Restart=always
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
